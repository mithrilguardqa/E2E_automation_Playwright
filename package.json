{
  "name": "e2e_api_with_playwright",
  "version": "1.0.0",
  "description": "Mithril Guard Company E2E and API testing framework with Playwright",
  "main": "index.ts",
  "scripts": {
    "clean-install": "find . -name 'node_modules' -type d -prune -exec rm -rf '{}' + ; npm install",
    "test": "npx playwright test",
    "test/e2e/ui": "npx playwright test tests/e2e/ --ui",
    "test/e2e/headed": "npx playwright test tests/e2e/ --headed",
    "test/e2e/headed/debug": "npx playwright test tests/e2e/ --headed --debug",
    "test/api": "npx playwright test tests/api/",
    "test/api/ui": "npx playwright test tests/api/ --ui"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mithrilguardqa/e2e_api_with_playwright.git"
  },
  "keywords": [],
  "author": "Mithril Guard QA Company",
  "license": "ISC",
  "type": "module",
  "bugs": {
    "url": "https://github.com/mithrilguardqa/e2e_api_with_playwright/issues"
  },
  "homepage": "https://github.com/mithrilguardqa/e2e_api_with_playwright#readme",
  "dependencies": {
    "@playwright/test": "^1.58.2",
    "@types/node": "^25.2.2",
    "@typescript-eslint/eslint-plugin": "^8.54.0",
    "@typescript-eslint/parser": "^8.54.0",
    "dotenv": "^17.2.4",
    "eslint": "^9.39.2",
    "eslint-plugin-import": "^2.32.0",
    "form-data": "^4.0.5",
    "prettier": "^3.8.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.54.0",
    "zod": "^4.3.6"
  }
}
