{
  "name": "e2e_with_playwright",
  "author": "Mithril Guard QA Company",
  "version": "1.0.0",
  "description": "Mithril Guard Company E2E testing framework with Playwright",
  "main": "index.js",
  "scripts": {
    "clean-install": "find . -name 'node_modules' -type d -prune -exec rm -rf '{}' + ; npm install",
    "test": "npx playwright test",
    "test/e2e/ui": "npx playwright test --ui",
    "test/e2e/headed": "npx playwright test --headed",
    "test/e2e/headed/debug": "npx playwright test --headed --debug",
    "upload-results": "node upload-results.js"
  },
  "keywords": [],
  "license": "ISC",
  "dependencies": {
    "@playwright/test": "^1.58.2",
    "@types/node": "^25.2.2",
    "@typescript-eslint/eslint-plugin": "^8.54.0",
    "@typescript-eslint/parser": "^8.54.0",
    "dotenv": "^17.2.4",
    "form-data": "^4.0.5",
    "eslint": "^9.39.2",
    "eslint-plugin-import": "^2.32.0",
    "prettier": "^3.8.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.54.0"
  }
}
